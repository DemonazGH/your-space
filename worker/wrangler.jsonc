{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "personal-guide-api",
  "main": "index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "observability": { "enabled": false },
  "vars": {
    "ALLOWED_ORIGIN": "https://demonazgh.github.io",
    "DATA_REPO": "DemonazGH/personal-guide-data"
  },
  "ratelimits": [{
    "name": "SAVE_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 30, "period": 60 }
  }]
}
